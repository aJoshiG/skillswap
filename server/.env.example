NODE_ENV=development
PORT=4000
# Sessions and credits use transactions, so MongoDB must be a replica set: run `npm run db`
# (local replica set on :27018), or use Atlas / Docker Compose.
MONGO_URI=mongodb://127.0.0.1:27018/skillswap?replicaSet=rs0
CLIENT_URL=http://localhost:4200

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Use COOKIE_SAMESITE=none and COOKIE_SECURE=true when the client and API are on different domains
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
